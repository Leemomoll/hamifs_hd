<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hamifs.mapper.UserMapper">

    <resultMap id="UserMap" type="com.hamifs.entity.User">
        <id     column="id"          property="id"/>
        <result column="username"    property="username"/>
        <result column="password"    property="password"/>
        <result column="name"        property="name"/>
        <result column="avatar"      property="avatar"/>
        <result column="status"      property="status"/>
        <result column="created_at"  property="createdAt"/>
        <result column="updated_at"  property="updatedAt"/>
    </resultMap>

    <sql id="cols">
        id, username, password, name, avatar, status, created_at, updated_at
    </sql>

    <select id="selectByUsername" resultMap="UserMap">
        SELECT <include refid="cols"/>
        FROM sys_user
        WHERE username = #{username}
        LIMIT 1
    </select>

    <select id="selectById" resultMap="UserMap">
        SELECT <include refid="cols"/>
        FROM sys_user
        WHERE id = #{id}
        LIMIT 1
    </select>

    <insert id="insertIfAbsent" parameterType="com.hamifs.entity.User">
        INSERT IGNORE INTO sys_user (username, password, name, avatar, status)
        VALUES (#{username}, #{password}, #{name}, #{avatar}, #{status})
    </insert>

    <!-- 列表查询：刻意不返回 password 字段 -->
    <select id="list" resultMap="UserMap">
        SELECT id, username, name, avatar, status, created_at, updated_at
        FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
        </where>
    </select>
</mapper>